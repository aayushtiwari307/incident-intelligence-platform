# Web environment. Copy to apps/web/.env.local (git-ignored).
#
# SECURITY: anything prefixed NEXT_PUBLIC_ is embedded in the browser bundle and visible to
# every visitor. Never put secrets, tokens, passwords or API keys in this file.
# scripts/check-repo-hygiene.mjs fails CI if a secret-looking name appears here.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
