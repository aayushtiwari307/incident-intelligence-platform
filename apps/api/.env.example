# API environment. Copy to apps/api/.env (git-ignored).
# Every variable is validated at startup (src/config/env.ts). Blank values count as unset.
# Real secrets belong ONLY in the real .env or your secret manager, never in this file.

NODE_ENV=development

# Bind to loopback by default. Use 0.0.0.0 only inside a container behind a trusted network.
API_HOST=127.0.0.1
API_PORT=3001

# Must match the values in the root .env used by docker-compose (host port 5545).
DATABASE_URL=postgresql://platform:dev_only_change_me@127.0.0.1:5545/platform
# REDIS_URL is optional and currently unused: no API code connects to Redis. If set it must still be a valid
# redis:// or rediss:// URL. Leave it out.
# REDIS_URL=

# Number of reverse proxies in front of the API (0 = none; 1 behind the single-origin proxy of docker-compose.edge.yml).
# This decides which client IP the rate limiters see: with 0 behind a proxy everyone shares one bucket, with too many
# clients can spoof their IP. This replaces the old boolean
# TRUST_PROXY, which is rejected at startup: `true` meant "trust every client-supplied
# X-Forwarded-For", which lets clients bypass IP rate limiting.
TRUST_PROXY_HOPS=0

# Comma-separated exact origins allowed by CORS. Empty = no cross-origin access. No wildcards.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# apply = run pending migrations at startup (dev), check = fail if any are pending (default),
# off = do nothing (migrations handled by a separate deploy step).
MIGRATE_ON_START=apply

# Session cookie and invitation lifetimes in hours (defaults: 168 = 7 days).
# SESSION_TTL_HOURS=168
# INVITE_TTL_HOURS=168

LOG_LEVEL=info

# AI is optional. With AI_PROVIDER=none (default) every core incident feature still works.
AI_PROVIDER=none
# OPENAI_API_KEY=
# GEMINI_API_KEY=          (gemini is accepted by the config but NOT implemented: AI stays off)
# Model name sent to OpenAI and the per-request timeout. The default model name is configurable because model
# availability changes; it has not been verified against the live API.
# AI_MODEL=gpt-5-mini
# AI_TIMEOUT_MS=30000

# Real-time updates (Socket.IO). Disabled by default; REST works independently.
REALTIME_ENABLED=false
# How often live connections are re-checked against the database (1-300 seconds).
# REALTIME_REVALIDATE_SECONDS=10

# Alertmanager webhook body limit in bytes (default 1048576; the webhook accepts at most 50 alerts per request).
# WEBHOOK_BODY_LIMIT_BYTES=1048576
# Required only if REALTIME_ENABLED=true; use a dedicated direct (not pooled) connection.
REALTIME_DATABASE_URL=

# Public signup defaults on outside production and off in production.
# PUBLIC_REGISTRATION_ENABLED=true
