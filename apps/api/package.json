{
  "name": "@platform/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS modular-monolith API",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev:compile": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:run": "node --watch-path=dist --env-file-if-exists=.env dist/main.js",
    "start": "node dist/main.js",
    "test": "jest",
    "test:integration": "jest -c jest.integration.config.js --runInBand",
    "migrate": "node --env-file-if-exists=.env dist/db/migrate/cli.js apply",
    "migrate:status": "node --env-file-if-exists=.env dist/db/migrate/cli.js check",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@platform/shared": "*",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1"
  }
}
