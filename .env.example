# Used by docker-compose.yml only. Copy to .env (git-ignored) and change the values.
# These are local-dev placeholders, not secrets: never reuse them anywhere real.
POSTGRES_USER=platform
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=platform

# Optional application-container settings (never commit real credentials).
LOG_LEVEL=info
AI_PROVIDER=none
# Grounded AI suggestions (M9) are OFF unless AI_ENABLED=true AND a usable provider is set AND an owner/admin turns them
# on for the organization. AI_PROVIDER=fake is a keyless, deterministic, non-production provider for trying it locally.
AI_ENABLED=false
# AI_DAILY_REQUEST_LIMIT=20
# AI_MODEL=gpt-5-mini
# AI_TIMEOUT_MS=30000
# OPENAI_API_KEY=
# CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# REDIS_URL=            (optional and currently unused by the API)
# Real-time listener is off by default. Enable only with a separate direct PostgreSQL URL.
REALTIME_ENABLED=false
# TRUST_PROXY_HOPS=0    (1 behind the single-origin proxy, see docker-compose.edge.yml)
# EDGE_PORT=8080        (host port of the optional reverse proxy)
# PUBLIC_ORIGIN=http://127.0.0.1:8080 (exact browser-visible origin for the edge profile; set to the full HTTPS URL for a tunnel)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
# Required only if REALTIME_ENABLED=true; use a dedicated direct (not pooled) connection.
REALTIME_DATABASE_URL=

# Public signup defaults on outside production and off in production. Set explicitly for CI/test stacks.
# PUBLIC_REGISTRATION_ENABLED=true
