# Used by docker-compose.yml only. Copy to .env (git-ignored) and change the values.
# These are local-dev placeholders, not secrets: never reuse them anywhere real.
POSTGRES_USER=platform
POSTGRES_PASSWORD=dev_only_change_me
POSTGRES_DB=platform
REDIS_PASSWORD=dev_only_change_me

# Optional application-container settings (never commit real credentials).
LOG_LEVEL=info
AI_PROVIDER=none
# AI_MODEL=gpt-5-mini
# AI_TIMEOUT_MS=30000
# OPENAI_API_KEY=
# CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
